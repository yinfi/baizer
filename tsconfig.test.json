{
    "compilerOptions": {
        "baseUrl": ".",
        "module": "commonjs",
        "target": "ES2020",
        "lib": [
            "DOM",
            "ESNext"
        ],
        "types": [
            "node"
        ],
        "paths": {
            "obsidian": ["./test/__mocks__/obsidian.ts"]
        },
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "outDir": "dist_test",
        "skipLibCheck": true,
        "noUnusedLocals": false
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ]
}