    },
    "tabHidden": {
      "display": "none"
    },
    "tabVisible": {
      "display": "block"
    },
    "timeline": {
      "display": "none"
    },
    "suggestions": {
      "display": "none"
    },
    "unreadHidden": {
      "display": "none"
    },
    "unreadShown": {
      "display": "flex"
    },
    "textareaFocusShadow": {
      "box-shadow": "none"
    }
  },
  "diff-wide-dark": {
    "modal": {
      "w": 802,
      "h": 240
    },
    "modalCss": {
      "width": "760px",
