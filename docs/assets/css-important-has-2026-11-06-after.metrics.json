      "color": "rgb(68, 207, 110)",
      "background-color": "color(srgb 0.266667 0.811765 0.431373 / 0.15)",
      "font-style": "italic"
    },
    "activeGutter": {
      "background-color": "rgba(0, 0, 0, 0)"
    },
    "gutter": {
      "background-color": "rgba(0, 0, 0, 0)"
    }
  },
  "motion-normal": {
    "cursor": {
      "animation-name": "cursor-blink",
      "animation-duration": "0.8s"
    },
    "strip": {
      "animation-name": "shell-knowledge-pulse",
      "animation-duration": "1.5s"
    },
    "output": {
      "scroll-behavior": "smooth"
    },
    "shellVars": {
      "--baizer-transition-fast": "120ms ease",
      "--baizer-transition-base": "200ms ease"
    },
    "applyBtnTransition": null
  },
  "motion-reduce": {
    "cursor": {
      "animation-name": "none",
      "animation-duration": "0s"
    },
    "strip": {
      "animation-name": "none",
      "animation-duration": "0s"
    },
    "output": {
      "scroll-behavior": "auto"
    },
    "shellVars": {
      "--baizer-transition-fast": "0.001ms linear",
      "--baizer-transition-base": "0.001ms linear"
    },
    "applyBtnTransition": null
  }
}