{
  "shell-light": {
    "leaf": {
      "display": "flex",
      "flex-direction": "column"
    },
    "viewContent": {
      "display": "flex",
      "flex-direction": "column",
      "flex-grow": "1"
    },
    "shellView": {
      "display": "flex",
      "flex-direction": "column",
      "height": "612px",
      "width": "420px"
    },
    "shellViewRect": {
      "w": 448,
      "h": 640
    },
    "historyMenu": {
      "display": "none"
    },
    "tabHidden": {
      "display": "none"
    },
    "tabVisible": {
      "display": "block"
    },
    "timeline": {
      "display": "none"
    },
    "suggestions": {
      "display": "none"
    },
    "unreadHidden": {
      "display": "none"
    },
    "unreadShown": {
      "display": "flex"
    },
    "textareaFocusShadow": {
      "box-shadow": "none"
    }
  },
  "diff-wide-light": {
    "modal": {
      "w": 802,
      "h": 240
    },
    "modalCss": {
      "width": "760px",
      "max-width": "760px"
    },
    "content": {
      "width": "720px",
      "height": "198px"
    },
    "contentRect": {
      "w": 720,
      "h": 198
    },
    "paneCode": {
      "min-height": "84px",
      "max-height": "124.8px"
    }
  },
  "diff-narrow-light": {
    "modal": {
      "w": 490,
      "h": 388
    },
    "modalCss": {
      "width": "448px",
      "max-width": "448px"
    },
    "content": {
      "width": "448px",
      "height": "346px"
    },
    "contentRect": {
      "w": 448,
      "h": 346
    },
    "paneCode": {
      "min-height": "84px",
      "max-height": "124.8px"
    }
  },
  "editor-light": {
    "ghost": {
      "color": "rgb(42, 157, 74)",
      "background-color": "color(srgb 0.164706 0.615686 0.290196 / 0.15)",
      "font-style": "italic"
    },
    "activeGutter": {
      "background-color": "rgba(0, 0, 0, 0)"
    },
    "gutter": {
      "background-color": "rgba(0, 0, 0, 0)"
    }
  },
